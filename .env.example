# Copy to .env to override. Every app works with these defaults when no .env exists.

# Platform (Go)
DATABASE_URL=postgres://flagguard:flagguard@localhost:5432/flagguard?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PROMETHEUS_URL=http://localhost:9090
# Platform uses 8080, QuickCart server uses 4000
PORT=8080
ADMIN_TOKEN=dev-admin-token

# Platform and QuickCart server
SDK_API_KEY=dev-sdk-key
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# QuickCart server
PLATFORM_URL=http://localhost:8080

# Dashboard and QuickCart web
VITE_PLATFORM_URL=http://localhost:8080
VITE_ADMIN_TOKEN=dev-admin-token
VITE_QUICKCART_URL=http://localhost:4000
VITE_USE_MOCKS=false
